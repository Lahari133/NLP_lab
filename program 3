import pandas as pd
from sklearn.preprocessing import OneHotEncoder
categories=['doctor','teacher','nurse','police']
data=pd.DataFrame({'Category':categories})
encoded=OneHotEncoder(sparse_output=False,dtype=int)
encoded_data=encoded.fit_transform(data)
encoded_df=pd.DataFrame(encoded_data,columns=categories)
encoded_df.head()

from sklearn.feature_extraction.text import CountVectorizer
documents=["This is the first document",
          "This document is second document",
          "And this is the third one",
          "Is this the last one"]
data=pd.DataFrame({'Text':documents})
vectorizer=CountVectorizer(ngram_range=(2,3))
ngram_vectors=vectorizer.fit_transform(data['Text'])
ngram_df=pd.DataFrame(ngram_vectors.toarray(),columns=vectorizer.get_feature_names_out())
ngram_df.head()
